<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Plugin SDK v2 permissions -->
    <permission android:name="cz.opentree.limessh.permission.OPEN_SESSIONS"
        android:protectionLevel="dangerous" android:label="Open SSH sessions" />
    <permission android:name="cz.opentree.limessh.permission.READ_CONNECTIONS"
        android:protectionLevel="dangerous" android:label="Read connections" />
    <permission android:name="cz.opentree.limessh.permission.WRITE_CONNECTIONS"
        android:protectionLevel="dangerous" android:label="Write connections" />
    <permission android:name="cz.opentree.limessh.permission.READ_SNIPPETS"
        android:protectionLevel="dangerous" android:label="Read snippets" />
    <permission android:name="cz.opentree.limessh.permission.WRITE_SNIPPETS"
        android:protectionLevel="dangerous" android:label="Write snippets" />
    <permission android:name="cz.opentree.limessh.permission.READ_PORT_FORWARDS"
        android:protectionLevel="dangerous" android:label="Read port forwards" />
    <permission android:name="cz.opentree.limessh.permission.WRITE_PORT_FORWARDS"
        android:protectionLevel="dangerous" android:label="Write port forwards" />
    <permission android:name="cz.opentree.limessh.permission.READ_GROUPS"
        android:protectionLevel="dangerous" android:label="Read groups" />
    <permission android:name="cz.opentree.limessh.permission.WRITE_GROUPS"
        android:protectionLevel="dangerous" android:label="Write groups" />
    <permission android:name="cz.opentree.limessh.permission.READ_PLUGIN_LOG"
        android:protectionLevel="normal" android:label="Read plugin log" />

    <application
        android:name=".LimeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LimeSSH">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ssh" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Plugin SDK v2 Content Provider -->
        <provider
            android:name=".plugin.PluginProvider"
            android:authorities="cz.opentree.limessh.api.v2"
            android:exported="true"
            android:readPermission="cz.opentree.limessh.permission.READ_CONNECTIONS"
            android:writePermission="cz.opentree.limessh.permission.WRITE_CONNECTIONS" />

        <!-- Home screen widget -->
        <receiver
            android:name=".ui.widget.LimeWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>

</manifest>
