# ──────────────────────────────────────────────
# LimeSSH — .gitignore
# ──────────────────────────────────────────────

# Local proprietary artifact analysis — never commit extracted APK contents
/.artifact-analysis/

# Android / Gradle build outputs
.gradle/
build/
local.properties
*.iml
.idea/
.DS_Store
__pycache__/

# OS
Thumbs.db
*.swp
*~

# Signing keystores — never commit
*.jks
*.keystore

# Research APKs — the original binaries are kept out of the repo
*.apk
# except the base APK the build repackages
!juicessh-base.apk
