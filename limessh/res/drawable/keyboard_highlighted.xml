<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ffb1b1b1"/>
            <stroke
                android:width="1px"
                android:color="#ff000000"/>
            <padding
                android:left="2dp"
                android:top="10dp"
                android:right="2dp"
                android:bottom="10dp"/>
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp"/>
            <gradient
                android:startColor="#ffb1b1b1"
                android:endColor="#ffb1b1b1"
                android:angle="90"
                android:type="linear"
                android:centerColor="#ff7a7a7a"/>
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <solid android:color="#ffb1b1b1"/>
            <stroke
                android:width="1px"
                android:color="#ff000000"/>
            <padding
                android:left="2dp"
                android:top="10dp"
                android:right="2dp"
                android:bottom="10dp"/>
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp"/>
            <gradient
                android:startColor="#ffb1b1b1"
                android:endColor="#ffb1b1b1"
                android:angle="90"
                android:type="linear"
                android:centerColor="#ff7a7a7a"/>
        </shape>
    </item>
</selector>
