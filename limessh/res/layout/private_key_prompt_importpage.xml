<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_importpagelayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:inputType="textNoSuggestions">
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/radiogroup_import_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:textColor="@android:color/black"
            android:id="@+id/radio_file_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/file_path"/>
        <RadioButton
            android:textColor="@android:color/black"
            android:id="@+id/radio_smart_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_search"/>
    </RadioGroup>
    <AutoCompleteTextView
        android:id="@+id/ac_manual_import_path_text"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_path_relative_to_sdcard"
        android:inputType="textUri"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_loading_smart_search"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:src="@drawable/spinner_black_16"
        android:contentDescription="@string/this_is_a_loading_indicator"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_loading_smart_search"
        android:paddingTop="5dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/searching"/>
    <ListView
        android:id="@+id/lv_smart_search_suggestions"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:autoLink="web"
        android:id="@+id/no_keys_found"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_private_keys_found"/>
</LinearLayout>
