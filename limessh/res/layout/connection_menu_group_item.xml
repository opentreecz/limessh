<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/highlight"
    android:padding="@dimen/activity_padding"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="56dp">
        <TextView
            android:textSize="@dimen/text_item_title"
            android:textColor="@color/text_item_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@android:id/text1"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/menu_item_title"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/text_item_subtitle"
            android:textColor="@color/text_item_subtitle"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@android:id/text2"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/menu_item_subtitle"
            android:lines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_separator"
        android:background="#eeeeee"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
