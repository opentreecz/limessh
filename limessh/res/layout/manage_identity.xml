<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main_content"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:id="@+id/scroll_view"
        android:padding="@dimen/activity_padding"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableLayout
            android:orientation="horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableRow android:layout_width="match_parent">
                <TextView
                    android:textColor="@color/text_form_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_column="0"
                    android:text="@string/identity"
                    android:layout_weight="1"
                    style="?android:attr/listSeparatorTextViewStyle"/>
            </TableRow>
            <TableRow android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/nickname_colon"/>
                <EditText
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/identityNickname_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/optional"
                    android:layout_weight="1"/>
            </TableRow>
            <TableRow android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/username_colon"/>
                <EditText
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/identityUsername_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="textVisiblePassword"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/password_colon"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_form"
                    android:id="@+id/identityPassword_status"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/not_set"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="@dimen/text_button"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/identityPasswordButton"
                    android:background="@drawable/button"
                    android:padding="5dp"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginLeft="4dp"
                    android:text="@string/set_optional"
                    android:maxLines="1"
                    android:layout_weight="1"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/private_key_colon"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/identityPrivateKey_status"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/not_set"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="@dimen/text_button"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/identityPrivateKey_button"
                    android:background="@drawable/button"
                    android:padding="5dp"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginLeft="4dp"
                    android:text="@string/set_optional"
                    android:maxLines="1"
                    android:layout_weight="1"/>
            </TableRow>
            <TableRow
                android:id="@+id/snippet_header_row"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textColor="@color/text_form_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_column="0"
                    android:text="@string/snippet"
                    android:layout_weight="1"
                    style="?android:attr/listSeparatorTextViewStyle"/>
            </TableRow>
            <TableRow
                android:layout_gravity="center_vertical"
                android:id="@+id/snippet_row"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pro_users_can_public_key_snippet"
                    android:layout_weight="1"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:id="@+id/snippet_button_row"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp">
                <Button
                    android:textSize="@dimen/text_button"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/generate_snippet"
                    android:background="@drawable/button"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="@string/generate_snippet"
                    android:layout_weight="1"/>
            </TableRow>
        </TableLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:id="@+id/bottom_buttons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_padding"
        android:layout_below="@+id/scroll_view">
        <Button
            android:id="@+id/button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            style="?android:attr/buttonBarNegativeButtonStyle"/>
        <Button
            android:id="@+id/button_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            style="?android:attr/buttonBarPositiveButtonStyle"/>
    </LinearLayout>
</RelativeLayout>
