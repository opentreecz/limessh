<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:scrollbars="vertical"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TableLayout
        android:orientation="horizontal"
        android:id="@+id/ec2ProfileTableForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <TableRow
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/form_name"/>
            <EditText
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:id="@+id/name_value"
                android:nextFocusLeft="@+id/name_value"
                android:nextFocusUp="@+id/name_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/form_enabled"/>
            <CheckBox
                android:id="@+id/enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:gravity="center_vertical"
                android:id="@+id/ec2_disabled_reason"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:drawableLeft="@drawable/ic_dialog_alert_holo_light"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/form_region"/>
            <Spinner
                android:id="@+id/region_spinner"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"/>
            <ImageButton
                android:gravity="center"
                android:id="@+id/refresh_regions"
                android:background="@drawable/button"
                android:padding="4dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="5dp"
                android:src="@drawable/ic_popup_sync_6"
                android:scaleType="fitCenter"
                android:contentDescription="@string/update_region_list"/>
        </TableRow>
        <TableRow
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/custom_endpoint"/>
            <EditText
                android:enabled="false"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:id="@+id/custom_endpoint_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textVisiblePassword"/>
        </TableRow>
        <TableRow
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/form_aws_key"/>
            <EditText
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:id="@+id/ec2_key_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textVisiblePassword"/>
        </TableRow>
        <TableRow
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="@string/form_aws_secret"/>
            <EditText
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/text_form"
                android:id="@+id/ec2_secret_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textVisiblePassword"/>
        </TableRow>
    </TableLayout>
</ScrollView>
