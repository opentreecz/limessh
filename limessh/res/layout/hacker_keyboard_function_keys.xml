<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:stretchColumns="*">
    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_f1"
            android:tag="-11"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/f1"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_f2"
            android:tag="-12"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/f2"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_f3"
            android:tag="-13"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/f3"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_f4"
            android:tag="-14"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/f4"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_f5"
            android:tag="-15"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/f5"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
