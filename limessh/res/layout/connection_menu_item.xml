<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/highlight"
    android:padding="@dimen/activity_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_item_height">
    <cz.opentree.limessh.views.FontAwesomeTextView
        android:textSize="30dp"
        android:textColor="@color/icon_item"
        android:gravity="center"
        android:id="@+id/itemIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="@string/icon_globe"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/icon"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_padding"
        android:paddingRight="@dimen/activity_padding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/itemIcon">
        <TextView
            android:textSize="@dimen/text_item_title"
            android:textColor="@color/text_item_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/itemTitle"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/menu_item_title"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/text_item_subtitle"
            android:textColor="@color/text_item_subtitle"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/itemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/menu_item_subtitle"
            android:lines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_separator"
        android:background="#eeeeee"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
