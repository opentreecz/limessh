<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TableLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TableRow android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="#ff6c6c6c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/nickname_colon"/>
                <EditText
                    android:textSize="12sp"
                    android:textColor="#ff6c6c6c"
                    android:id="@+id/identityNickname_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/optional"
                    android:layout_weight="1"
                    android:inputType="textNoSuggestions"/>
            </TableRow>
            <TableRow android:layout_marginTop="10dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="#ff6c6c6c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/username_colon"/>
                <EditText
                    android:textSize="12sp"
                    android:textColor="#ff6c6c6c"
                    android:id="@+id/identityUsername_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="textNoSuggestions"/>
            </TableRow>
        </TableLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/show_password_clickable"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="18sp"
                android:textColor="#ff6c6c6c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="Password"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff6c6c6c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(show less)"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/password_set_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp">
            <Button
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/password_clear_button"
                android:background="@drawable/button"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginRight="5dp"
                android:text="@string/clear"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff6c6c6c"
                android:id="@+id/password_set_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Set: 4 days ago"/>
        </LinearLayout>
        <EditText
            android:textSize="12sp"
            android:textColor="#ff6c6c6c"
            android:id="@+id/edit_password"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/optional"
            android:inputType="textPassword"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/show_key_clickable"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="#ff6c6c6c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="Private Key"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff6c6c6c"
                android:id="@+id/show_more_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(show more)"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/identityPrivateKey_button"
                android:background="@drawable/button"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginRight="5dp"
                android:text="@string/clear"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff6c6c6c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Set: 4 days ago"/>
        </LinearLayout>
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/radiogroup_import_type"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textColor="@android:color/black"
                android:id="@+id/radio_file_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/smart_search"/>
            <RadioButton
                android:textColor="@android:color/black"
                android:id="@+id/radio_smart_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paste"/>
        </RadioGroup>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_loading_smart_search"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/spinner_black_16"
            android:contentDescription="@string/this_is_a_loading_indicator"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_loading_smart_search"
            android:paddingTop="5dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/searching"/>
        <FrameLayout
            android:id="@+id/lv_smart_search_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
