<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_width="50dp"
            android:layout_height="50dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/text_heading"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/welcome"
            android:layout_weight="0.5"/>
        <TextView
            android:textSize="@dimen/text_item_subtitle"
            android:textColor="@color/text_item_subtitle"
            android:gravity="top|center_horizontal"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="10dp"
            android:text="@string/youve_not_connected_yet"
            android:maxLines="10"
            android:layout_weight="0.5"/>
    </LinearLayout>
    <ListView
        android:id="@+id/page_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:childDivider="@drawable/highlight"
        android:divider="@drawable/highlight"
        android:dividerHeight="0.5dp"
        android:headerDividersEnabled="true"
        android:footerDividersEnabled="true"/>
</LinearLayout>
