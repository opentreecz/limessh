<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:stretchColumns="*">
    <TableRow
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_esc"
            android:tag="111"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/esc"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_span="2">
            <cz.opentree.limessh.views.AutoRepeatButton
                android:textSize="18sp"
                android:id="@+id/keyboard_forwardslash"
                android:tag="76"
                android:background="@drawable/keyboard"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:text="@string/forwardslash"
                android:layout_weight="0.33"
                android:hapticFeedbackEnabled="true"
                android:onClick="keyboardPress"/>
            <cz.opentree.limessh.views.AutoRepeatButton
                android:textSize="18sp"
                android:id="@+id/keyboard_pipe"
                android:tag="-1"
                android:background="@drawable/keyboard"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:text="@string/pipe"
                android:layout_weight="0.33"
                android:hapticFeedbackEnabled="true"
                android:onClick="keyboardPress"/>
            <cz.opentree.limessh.views.AutoRepeatButton
                android:textSize="18sp"
                android:id="@+id/keyboard_dash"
                android:tag="69"
                android:background="@drawable/keyboard"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:text="@string/dash"
                android:layout_weight="0.33"
                android:hapticFeedbackEnabled="true"
                android:onClick="keyboardPress"/>
        </LinearLayout>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_home"
            android:tag="122"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/home"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="18sp"
            android:textStyle="bold"
            android:id="@+id/keyboard_up"
            android:tag="19"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/up_arrow"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_end"
            android:tag="123"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/end"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_pgup"
            android:tag="92"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/page_up"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.TerminalThemedButton
            android:textSize="14sp"
            android:id="@+id/keyboard_function_keys"
            android:tag="-3"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/fn"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
    </TableRow>
    <TableRow
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_tab"
            android:tag="61"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/tab"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.TerminalThemedButton
            android:textSize="14sp"
            android:id="@+id/keyboard_ctrl"
            android:tag="-2"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/ctrl"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.TerminalThemedButton
            android:textSize="14sp"
            android:id="@+id/keyboard_alt"
            android:tag="-4"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/alt"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="18sp"
            android:textStyle="bold"
            android:id="@+id/keyboard_left"
            android:tag="21"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/left_arrow"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="18sp"
            android:textStyle="bold"
            android:id="@+id/keyboard_down"
            android:tag="20"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/down_arrow"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="18sp"
            android:textStyle="bold"
            android:id="@+id/keyboard_right"
            android:tag="22"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/right_arrow"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.AutoRepeatButton
            android:textSize="14sp"
            android:id="@+id/keyboard_pgdn"
            android:tag="93"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/page_down"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"/>
        <cz.opentree.limessh.views.TerminalThemedImageButton
            android:id="@+id/keyboard_toggle"
            android:tag="-5"
            android:background="@drawable/keyboard"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_lockscreen_ime"
            android:hapticFeedbackEnabled="true"
            android:onClick="keyboardPress"
            android:contentDescription="@string/toggle_keyboard"/>
    </TableRow>
</TableLayout>
