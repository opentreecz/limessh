<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/highlight"
    android:layout_width="match_parent"
    android:layout_height="55dp">
    <TextView
        android:icon="@drawable/ic_action_search"
        android:textSize="32dp"
        android:textColor="@color/card_icon_color"
        android:id="@+id/itemIcon"
        android:paddingLeft="8dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/icon_globe"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/icon"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingRight="@dimen/activity_padding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/itemIcon">
        <TextView
            android:textSize="@dimen/text_item_title"
            android:textColor="@color/text_item_title"
            android:ellipsize="end"
            android:id="@+id/itemTitle"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_item_title"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/text_item_subtitle"
            android:textColor="@color/text_item_subtitle"
            android:ellipsize="end"
            android:id="@+id/itemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_item_subtitle"
            android:lines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"/>
    </LinearLayout>
</RelativeLayout>
