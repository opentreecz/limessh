<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:padding="@dimen/activity_padding"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableLayout
            android:orientation="horizontal"
            android:id="@+id/table"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableRow android:layout_width="match_parent">
                <TextView
                    android:textColor="@color/text_form_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_column="0"
                    android:text="@string/port_forward"
                    android:layout_weight="1"
                    style="?android:attr/listSeparatorTextViewStyle"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/name"/>
                <EditText
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="text"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/connection_colon"/>
                <Spinner
                    android:id="@+id/connection_spinner"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/mode_colon"/>
                <Spinner
                    android:id="@+id/mode_spinner"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:id="@+id/row_local_port"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/port_from"/>
                <EditText
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/local_port"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxEms="5"
                    android:ems="5"
                    android:maxLength="5"
                    android:inputType="number"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:id="@+id/row_remote_host"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/destination"/>
                <EditText
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/remote_host"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/localhost"
                    android:layout_weight="1"
                    android:inputType="textVisiblePassword"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:id="@+id/row_remote_port"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/port_to"/>
                <EditText
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/remote_port"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxEms="5"
                    android:ems="5"
                    android:maxLength="5"
                    android:inputType="number"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:id="@+id/row_open_in_browser"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <CheckBox
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/open_in_browser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/open_in_browser"
                    android:layout_weight="1"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:id="@+id/row_socks_explanation"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:autoLink="web"
                    android:id="@+id/socks_explanation"
                    android:paddingTop="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/socks_description"
                    android:layout_weight="1"/>
            </TableRow>
            <TableRow
                android:gravity="center_vertical"
                android:id="@+id/row_use_as_proxy"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp">
                <CheckBox
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/text_form"
                    android:id="@+id/use_as_proxy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="@string/set_as_browser_proxy"
                    android:layout_weight="1"/>
            </TableRow>
        </TableLayout>
    </ScrollView>
</RelativeLayout>
