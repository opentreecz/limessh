<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/highlight"
    android:padding="@dimen/activity_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_item_height"
    android:minHeight="@dimen/list_item_height">
    <ImageView
        android:gravity="center"
        android:id="@+id/itemIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/icon"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_padding"
        android:paddingRight="@dimen/activity_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/itemIcon">
        <TextView
            android:textSize="@dimen/text_item_title"
            android:textColorHighlight="@color/text_item_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/itemTitle"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/menu_item_title"
            android:lines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/text_item_subtitle"
            android:textColor="@color/text_item_subtitle"
            android:textColorHighlight="@color/text_item_subtitle"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/itemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="@string/menu_item_subtitle"
            android:lines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"/>
    </LinearLayout>
    <Button
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/respond_button"
        android:background="@drawable/button"
        android:padding="5dp"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginRight="6dp"
        android:text="@string/respond"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
