<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/activity_padding"
                android:layout_marginRight="@dimen/activity_padding">
                <TableLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textColor="@color/text_form_heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/team"
                            android:layout_weight="1"
                            style="?android:attr/listSeparatorTextViewStyle"/>
                    </TableRow>
                    <TableRow android:layout_marginTop="8dp">
                        <TextView
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/text_form"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/name"/>
                        <EditText
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/text_form"
                            android:id="@+id/teamName_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="textNoSuggestions"/>
                    </TableRow>
                    <TableRow
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/text_form"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:text="@string/password_colon"/>
                        <TextView
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="@color/text_form"
                            android:id="@+id/identityPassword_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:text="@string/not_set"
                            android:layout_weight="1"/>
                        <ImageButton
                            android:layout_gravity="right"
                            android:id="@+id/password_button"
                            android:background="@drawable/button"
                            android:padding="4dp"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_menu_manage"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/manage_password"/>
                    </TableRow>
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:textColor="@color/text_form_heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:text="@string/team_members"
                            android:layout_weight="1"
                            style="?android:attr/listSeparatorTextViewStyle"/>
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
