<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:id="@+id/list"
            android:padding="@dimen/card_list_padding"
            android:visibility="visible"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#00000000"
            android:dividerHeight="@dimen/card_list_divider"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/loading_layout"
            android:padding="16dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_width="50dp"
                android:layout_height="50dp"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_item_subtitle"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/loading_dot_dot_dot"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/error_layout"
            android:padding="16dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <cz.opentree.limessh.views.FontAwesomeTextView
                android:textSize="50dp"
                android:textColor="@color/icon_item"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/icon_warning_sign"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_item_title"
                android:gravity="center_horizontal"
                android:padding="8dp"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/an_error_has_occurred"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_item_subtitle"
                android:gravity="center_horizontal"
                android:id="@+id/error_message"
                android:padding="8dp"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/please_try_again_later"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
