<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:padding="@dimen/activity_padding"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableLayout
                android:orientation="horizontal"
                android:id="@+id/connectionTableForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/text_form_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/basic_settings"
                    style="?android:attr/listSeparatorTextViewStyle"/>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/nicknameRow"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/form_nickname"/>
                    <EditText
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:id="@+id/nickname_value"
                        android:nextFocusLeft="@+id/nickname_value"
                        android:nextFocusUp="@+id/nickname_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/form_optional"
                        android:layout_weight="1"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/typeRow"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/type_colon"/>
                    <Spinner
                        android:id="@+id/type_spinner"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:prompt="@string/pick_one"
                        android:layout_weight="1"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/addressRow"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/form_address"/>
                    <EditText
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:id="@+id/address_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textVisiblePassword"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/identityRow"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/form_identity"/>
                    <Spinner
                        android:id="@+id/idSpinner"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:prompt="@string/choose_an_identity"
                        android:layout_weight="1"/>
                </TableRow>
                <TextView
                    android:textColor="@color/text_form_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/advanced_settings"
                    style="?android:attr/listSeparatorTextViewStyle"/>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/portRow"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/form_port"/>
                    <EditText
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:id="@+id/port_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="@string/form_22"
                        android:maxEms="5"
                        android:ems="5"
                        android:maxLength="5"
                        android:inputType="number"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/viaRow"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/form_connect_via"/>
                    <Spinner
                        android:id="@+id/via_spinner"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:prompt="@string/form_optional"
                        android:layout_weight="1"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/runOnConnectRow"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/run_snippet"/>
                    <Spinner
                        android:id="@+id/snippetSpinner"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:prompt="@string/choose_a_snippet"
                        android:layout_weight="1"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/backspaceModeRow"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/backspace_mode"/>
                    <Spinner
                        android:id="@+id/backspaceModeSpinner"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"/>
                </TableRow>
                <TableRow
                    android:gravity="center_vertical"
                    android:id="@+id/mosh_command_row"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:text="@string/command"/>
                    <EditText
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@color/text_form"
                        android:id="@+id/mosh_command_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textVisiblePassword"/>
                </TableRow>
            </TableLayout>
            <TextView
                android:textColor="@color/text_form_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/groups"
                style="?android:attr/listSeparatorTextViewStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/group_selector_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
