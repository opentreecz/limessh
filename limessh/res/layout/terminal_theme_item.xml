<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/theme_name"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:lines="1"
        android:layout_weight="1"/>
    <TableLayout
        android:gravity="right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TableRow android:layout_marginBottom="4dp">
            <FrameLayout
                android:id="@+id/theme_color_0"
                android:background="#ff000000"
                android:layout_width="24dp"
                android:layout_height="8dp"/>
            <FrameLayout
                android:id="@+id/theme_color_1"
                android:background="#ff00cc00"
                android:layout_width="24dp"
                android:layout_height="8dp"/>
            <FrameLayout
                android:id="@+id/theme_color_2"
                android:background="#ff00ccff"
                android:layout_width="24dp"
                android:layout_height="8dp"/>
            <FrameLayout
                android:id="@+id/theme_color_3"
                android:background="#ffffccff"
                android:layout_width="24dp"
                android:layout_height="8dp"/>
        </TableRow>
        <TableRow android:layout_marginTop="4dp">
            <FrameLayout
                android:id="@+id/theme_color_4"
                android:background="#ff0000cc"
                android:layout_width="24dp"
                android:layout_height="8dp"/>
            <FrameLayout
                android:id="@+id/theme_color_5"
                android:background="#ffeeee00"
                android:layout_width="24dp"
                android:layout_height="8dp"/>
            <FrameLayout
                android:id="@+id/theme_color_6"
                android:background="#ffffcc00"
                android:layout_width="24dp"
                android:layout_height="8dp"/>
            <FrameLayout
                android:id="@+id/theme_color_7"
                android:background="#ff0ddffc"
                android:layout_width="24dp"
                android:layout_height="8dp"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
