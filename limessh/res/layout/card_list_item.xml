<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/card_item"
    card_view:cardBackgroundColor="@color/card_item_background"
    card_view:cardCornerRadius="2dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/itemContainer"
                android:padding="16dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="@dimen/text_item_title"
                        android:textColor="@color/text_item_title"
                        android:ellipsize="end"
                        android:id="@+id/itemTitle"
                        android:paddingRight="32dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:clickable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_item_title"/>
                    <TextView
                        android:textSize="@dimen/text_item_subtitle"
                        android:textColor="@color/text_item_subtitle"
                        android:ellipsize="end"
                        android:id="@+id/itemSubtitle"
                        android:paddingRight="32dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:clickable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_item_subtitle"/>
                </LinearLayout>
                <TextView
                    android:textSize="32dp"
                    android:textColor="@color/card_icon_color"
                    android:id="@+id/itemTextIcon"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_globe"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/icon"/>
                <ImageView
                    android:id="@+id/itemImageIcon"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/icon"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/banner"
                android:visibility="gone"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/new_banner"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/itemContent"
            android:padding="16dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-20dp"/>
        <View
            android:id="@+id/button1_divider"
            android:background="@color/card_item_divider"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/accent_bold"
            android:id="@+id/button1"
            android:background="@drawable/button_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/more_information"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
