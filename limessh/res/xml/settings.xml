<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <PreferenceCategory
        android:title="@string/general"
        android:key="general">
        <cz.opentree.limessh.views.dbpreferences.ListDBPreference
            android:persistent="false"
            android:entries="@array/dark_theme_names"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/dark_theme"
            android:key="theme:dark"
            android:entryValues="@array/dark_theme_values"/>
        <cz.opentree.limessh.views.ActionPreference
            android:persistent="false"
            android:id="@+id/manage_snippets"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/manage_snippets"
            android:key="action:manageSnippets"/>
        <cz.opentree.limessh.views.ActionPreference
            android:persistent="false"
            android:id="@+id/ec2_sync_profiles"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/amazon_ec2_link"
            android:key="action:manageEc2SyncProfiles"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/app_security"
        android:key="account">
        <cz.opentree.limessh.views.dbpreferences.EncSwitchDBPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/security_lock"
            android:key="pinlock:enabled"
            android:summary="@string/lock_limessh_after"/>
        <cz.opentree.limessh.views.ActionPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/clear_known_hosts"
            android:key="action:clear_known_hosts"
            android:summary="@string/removes_host_keys"/>
        <cz.opentree.limessh.views.dbpreferences.SwitchDBPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/ssh_agent_forwarding"
            android:key="ssh:agent"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/terminal"
        android:key="terminal">
        <cz.opentree.limessh.views.dbpreferences.TerminalThemeDBPreference
            android:persistent="false"
            android:entries="@array/terminal_theme_names"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/theme_slash_colors"
            android:key="terminal:theme"
            android:entryValues="@array/terminal_theme_values"/>
        <cz.opentree.limessh.views.dbpreferences.TerminalFontDBPreference
            android:persistent="false"
            android:entries="@array/font_names"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/font"
            android:key="terminal:font"
            android:entryValues="@array/font_names"/>
        <cz.opentree.limessh.views.dbpreferences.NumberDBPreference xmlns:custom="http://schemas.android.com/apk/res-auto"
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/font_size"
            android:key="terminal:font_size"
            custom:label="@string/font_size"
            custom:maxValue="30"
            custom:message="@string/you_can_adjust_the_font"
            custom:minValue="1"/>
        <cz.opentree.limessh.views.dbpreferences.NumberDBPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/terminal_margin"
            android:key="terminal:margin"
            android:summary="@string/useful_for_those_with_screen_protectors"
            custom:label="@string/pixels"
            custom:maxValue="128"
            custom:message="@string/specify_the_terminal_margin"
            custom:minValue="0"/>
        <cz.opentree.limessh.views.dbpreferences.ListDBPreference
            android:persistent="false"
            android:entries="@array/terminal_horizontal_swipe_mode_names"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/horizontal_swipe"
            android:key="terminal:horizontal_swipe_mode"
            android:entryValues="@array/terminal_horizontal_swipe_mode_values"/>
        <cz.opentree.limessh.views.dbpreferences.SwitchDBPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/utf8_support"
            android:key="terminal:utf8"/>
        <cz.opentree.limessh.views.dbpreferences.ListDBPreference
            android:persistent="false"
            android:entries="@array/terminal_typeTitles"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/emulator_type"
            android:key="terminal:type"
            android:entryValues="@array/terminal_typeValues"/>
        <cz.opentree.limessh.views.dbpreferences.ListDBPreference
            android:persistent="false"
            android:entries="@array/terminal_bell_mode_names"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/terminal_bell"
            android:key="terminal:bell_mode"
            android:entryValues="@array/terminal_bell_mode_values"/>
        <cz.opentree.limessh.views.dbpreferences.ListDBPreference
            android:persistent="false"
            android:entries="@array/terminal_keyboard_position_names"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/popup_keyboard_position"
            android:key="terminal:keyboard_position"
            android:entryValues="@array/terminal_keyboard_position_values"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/mosh"
        android:key="mosh">
        <cz.opentree.limessh.views.dbpreferences.TextDBPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/server_command"
            android:key="mosh:mosh-server"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/about_us"
        android:key="about_us">
        <cz.opentree.limessh.views.ActionPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/rate_us"
            android:key="action:rate_us"
            android:summary="@string/it_really_helps"/>
        <cz.opentree.limessh.views.ActionPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/website"
            android:key="action:website"
            android:summary="@string/website_address"/>
        <cz.opentree.limessh.views.ActionPreference
            android:persistent="false"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/about"
            android:key="action:software_licenses"
            android:summary="@string/components_and_licenses"/>
        <cz.opentree.limessh.views.ActionPreference
            android:persistent="false"
            android:id="@+id/version_menu_item"
            android:background="@drawable/highlight"
            android:layout="@layout/preference"
            android:title="@string/application_version"
            android:key="action:version"
            android:summary="@string/unknown_version"/>
    </PreferenceCategory>
</PreferenceScreen>
