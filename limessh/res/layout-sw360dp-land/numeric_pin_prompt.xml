<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@color/pinlock_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/activity_padding"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:textColor="@color/primary_bold"
            android:gravity="center"
            android:id="@+id/message"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/enter_your_pin_to_unlock"/>
        <EditText
            android:enabled="false"
            android:textSize="24sp"
            android:textColor="@color/primary_bold"
            android:gravity="center"
            android:id="@+id/passphrase"
            android:paddingTop="8dp"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="disabled"
            android:inputType="textPassword"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:padding="@dimen/activity_padding"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TableLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TableRow android:gravity="center">
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_1"
                    android:tag="1"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="1"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_2"
                    android:tag="2"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="2"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_3"
                    android:tag="3"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="3"/>
            </TableRow>
            <TableRow android:gravity="center">
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_4"
                    android:tag="4"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="4"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_5"
                    android:tag="5"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="5"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_6"
                    android:tag="6"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="6"/>
            </TableRow>
            <TableRow android:gravity="center">
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_7"
                    android:tag="7"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="7"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_8"
                    android:tag="8"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="8"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_9"
                    android:tag="9"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="9"/>
            </TableRow>
            <TableRow android:gravity="center">
                <cz.opentree.limessh.views.FontAwesomeTextView
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_backspace"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="@string/icon_eraser"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_0"
                    android:tag="0"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="0"/>
                <cz.opentree.limessh.views.FontAwesomeTextView
                    android:textSize="16sp"
                    android:textColor="@color/primary_bold"
                    android:gravity="center"
                    android:id="@+id/button_ok"
                    android:background="@drawable/pin_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:text="@string/ok"/>
            </TableRow>
        </TableLayout>
    </LinearLayout>
</LinearLayout>
