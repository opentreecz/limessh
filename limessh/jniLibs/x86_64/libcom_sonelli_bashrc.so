# Switch to the home directory
cd ~

export PATH="${JUICESSH_BIN_DIR}:$PATH";

if [ -f ${JUICESSH_BIN_DIR}/ls ]; then
    # We have a full version of ls
    # Enable colours
    alias ls="ls --color";
fi

alias bash=${JUICESSH_BIN_DIR}/libcom_sonelli_bash.so
alias telnet=${JUICESSH_BIN_DIR}/libcom_sonelli_telnet.so
alias mosh-client=${JUICESSH_BIN_DIR}/libcom_sonelli_mosh-client.so

# Run the user's ~/bashrc if they have one
if [ -f ~/.bashrc  ]; then . ~/.bashrc; fi
